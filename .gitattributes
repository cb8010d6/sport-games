* text=auto
*.gd text eol=lf
*.gdshader text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.import text eol=lf
*.uid text eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Unified patches require context prefixes before tabs and empty source lines.
tools/engine_patches/*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
tools/engine_patches/*.txt text eol=lf

# Generated assets use ordinary Git; upstream downloads are ignored and synced separately.
# Explicitly disable filters so these files never become LFS pointers.
*.glb binary -filter
*.bin binary -filter
*.hdr binary -filter
*.png binary -filter
*.jpg binary -filter
*.jpeg binary -filter
*.wav binary -filter
*.ico binary -filter
